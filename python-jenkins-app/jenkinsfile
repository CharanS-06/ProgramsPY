pipeline {
    agent {
        label 'AWS-EC2-Worker-Agent-1'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('charans06')
        IMAGE_NAME = 'charans06/newpythonapp'
        CONTAINER_NAME = 'python-jenkins-app'
    }
    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/CharanS-06/ProgramsPY.git'
                dir('python-jenkins-app') {
                    sh 'pwd'
                    sh 'ls -la'
                }
            }
        }
        stage('Test') {
            steps {
                dir('python-jenkins-app') {
                    sh '''
                        set -eu

                        python3 -m py_compile app.py test_app.py

                        VENV_DIR="$(mktemp -d)"
                        trap 'rm -rf "$VENV_DIR"' EXIT

                        python3 -m venv "$VENV_DIR"
                        . "$VENV_DIR/bin/activate"

                        python -m pip install -r requirements.txt
                        python -m pytest -v test_app.py
                    '''
                }
            }
        }
        stage('Build') {
            steps {
                dir('python-jenkins-app') {
                    sh '''
                        set -eu

                        docker build \
                            -t "${IMAGE_NAME}:${BUILD_NUMBER}" \
                            -t "${IMAGE_NAME}:latest" \
                            .
                    '''
                }
            }
        }  
        stage('Push') {
            steps {
                sh '''
                    set -eu
                    set +x

                    trap 'docker logout >/dev/null 2>&1 || true' EXIT

                    echo "$DOCKERHUB_CREDENTIALS_PSW" |
                        docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin

                    docker push "${IMAGE_NAME}:${BUILD_NUMBER}"
                    docker push "${IMAGE_NAME}:latest"
                '''
            }
        }
        stage('Run') {
            steps {
                sh 'docker rm -f "$CONTAINER_NAME" 2>/dev/null || true'
                sh 'docker run -d --name "$CONTAINER_NAME" --restart unless-stopped -p 5000:5000 "${IMAGE_NAME}:${BUILD_NUMBER}"'
            }
        }
        stage('Health Check') {
            steps {
                sh '''
                    for i in $(seq 1 15); do
                        if curl -fsS http://127.0.0.1:5000/health; then
                            echo "Application is healthy"
                            exit 0
                        fi

                        sleep 2
                    done

                    echo "Application health check failed"
                    docker logs "$CONTAINER_NAME"
                    exit 1
                '''
            }
        }
    }
}