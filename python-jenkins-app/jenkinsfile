
pipeline {
    agent {
        label 'AWS-EC2-Worker-Agent-1'
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        DOCKERHUB_CREDENTIALS = credentials('charans06')
        IMAGE_NAME = 'charans06/newpythonapp'
        UPSTREAM_FILE = '/etc/nginx/conf.d/active-app-upstream'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    changelog: false,
                    poll: false,
                    url: 'https://github.com/CharanS-06/ProgramsPY.git'

                dir('python-jenkins-app') {
                    sh 'pwd'
                    sh 'ls -la'
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-jenkins-app') {
                    sh '''
                        set -eu

                        python3 -m py_compile app.py test_app.py

                        VENV_DIR="$(mktemp -d)"
                        trap 'rm -rf "$VENV_DIR"' EXIT

                        python3 -m venv "$VENV_DIR"
                        . "$VENV_DIR/bin/activate"

                        python -m pip install -r requirements.txt
                        python -m pytest -v test_app.py
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('python-jenkins-app') {
                    sh '''
                        set -eu

                        docker build \
                            -t "${IMAGE_NAME}:${BUILD_NUMBER}" \
                            -t "${IMAGE_NAME}:latest" \
                            .
                    '''
                }
            }
        }

        stage('Push') {
            steps {
                sh '''
                    set -eu
                    set +x

                    trap 'docker logout >/dev/null 2>&1 || true' EXIT

                    echo "$DOCKERHUB_CREDENTIALS_PSW" |
                        docker login \
                            -u "$DOCKERHUB_CREDENTIALS_USR" \
                            --password-stdin

                    docker push "${IMAGE_NAME}:${BUILD_NUMBER}"
                    docker push "${IMAGE_NAME}:latest"
                '''
            }
        }

        stage('Determine Deployment Slot') {
            steps {
                script {
                    env.ACTIVE_PORT = sh(
                        script: """
                            grep -oE '500[12]' '${UPSTREAM_FILE}' |
                            head -n 1
                        """,
                        returnStdout: true
                    ).trim()

                    if (env.ACTIVE_PORT == '5001') {
                        env.TARGET_PORT = '5002'
                    } else if (env.ACTIVE_PORT == '5002') {
                        env.TARGET_PORT = '5001'
                    } else {
                        error("Unexpected active port: ${env.ACTIVE_PORT}")
                    }

                    env.TARGET_CONTAINER =
                        "python-jenkins-app-slot-${env.TARGET_PORT}"

                    echo "Current active port: ${env.ACTIVE_PORT}"
                    echo "New deployment port: ${env.TARGET_PORT}"
                }
            }
        }

        stage('Deploy Inactive Slot') {
            steps {
                sh '''
                    set -eu

                    # The target slot is inactive, so its old container
                    # can be removed without stopping the active version.
                    OLD_IDS="$(docker ps -q --filter "publish=${TARGET_PORT}")"

                    if [ -n "$OLD_IDS" ]; then
                        echo "$OLD_IDS" | xargs -r docker rm -f
                    fi

                    docker run -d \
                        --name "$TARGET_CONTAINER" \
                        --restart unless-stopped \
                        -p "127.0.0.1:${TARGET_PORT}:5000" \
                        "${IMAGE_NAME}:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    set -eu

                    HEALTHY=0

                    for i in $(seq 1 15); do
                        if curl -fsS \
                            "http://127.0.0.1:${TARGET_PORT}/health"; then
                            HEALTHY=1
                            break
                        fi

                        sleep 2
                    done

                    if [ "$HEALTHY" -ne 1 ]; then
                        echo "New deployment failed its health check"
                        docker logs "$TARGET_CONTAINER"
                        exit 1
                    fi

                    echo "New version is healthy on port ${TARGET_PORT}"
                '''
            }
        }

        stage('Switch Traffic') {
            steps {
                sh '''
                    set -eu

                    sudo -n /usr/local/sbin/switch-python-app-backend \
                        "$TARGET_PORT"

                    curl --retry 5 --retry-delay 1 \
                        --retry-connrefused \
                        -fsS http://127.0.0.1/health

                    echo "Traffic switched to port ${TARGET_PORT}"
                '''
            }
        }
    }

    post {
        failure {
            script {
                if (env.TARGET_CONTAINER?.trim()) {
                    sh '''
                        docker rm -f "$TARGET_CONTAINER" \
                            2>/dev/null || true
                    '''
                }
            }

            echo 'Deployment failed. The previous Nginx backend should remain active.'
        }

        success {
            echo 'Blue-green deployment completed successfully.'
        }
    }
}
